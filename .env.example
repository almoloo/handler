DATABASE_URL=postgresql://postgres:handler@localhost:5432/handler
BASE_RPC_URL=
CHAIN_ID=31337
CHAIN_RPC_URL=http://127.0.0.1:8545  # local anvil; the prod api container (docker-compose.prod.yml) needs a real chain RPC URL here too
DEMO_TOKEN=changeme
ONEINCH_API_KEY=
RILEY_SESSION_KEY=  # 0x-prefixed 32-byte private key for the Riley catalog agent's session key; never the owner's key
LEDGER_ENABLED=true
SESSION_SECRET=  # 32+ char random string; signs the handler_session cookie
SESSION_TTL_SECONDS=604800
SIWE_NONCE_TTL_SECONDS=300
SIWE_DOMAIN=localhost  # RFC 4501 domain the SIWE message must be signed for; the deployed hostname in prod
SIWE_CHAIN_ID=31337    # chain id the SIWE message must declare; matches CHAIN_ID above

# docker-compose.prod.yml only (Coolify deployment) — local dev uses DATABASE_URL above instead
POSTGRES_USER=postgres          # postgres, api (via composed DATABASE_URL)
POSTGRES_PASSWORD=changeme      # postgres, api (via composed DATABASE_URL)
POSTGRES_DB=handler             # postgres, api (via composed DATABASE_URL)
PORT=3000                       # api
NEXT_PUBLIC_API_URL=            # web (public URL the browser uses to reach api)
