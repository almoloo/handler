DATABASE_URL=postgresql://postgres:handler@localhost:5432/handler
BASE_RPC_URL=
CHAIN_ID=31337
CHAIN_RPC_URL=http://127.0.0.1:8545  # local anvil; prod (docker-compose.prod.yml, via Coolify env vars) sets CHAIN_ID=8453 + a real Base mainnet RPC URL here — see context/current-feature.md's "Move the public deployment to Base mainnet" fix
DEMO_TOKEN=changeme
RILEY_SESSION_KEY=  # 0x-prefixed 32-byte private key for the Riley catalog agent's session key; never the owner's key
RILEY_PAYMENT_WEI=100000000000000  # fixed wei amount Riley pays the Subcontractor per run (0.0001 ETH, ~$0.25 on Base mainnet); a payment size, not a price — PriceConverter does the real USD valuation on-chain. Real ETH now that the public deployment is Base mainnet — lowered from 0.001 ETH accordingly (see context/current-feature.md)
VILLAIN_SESSION_KEY=  # 0x-prefixed 32-byte private key for the villain's session key; an adversarial test actor (demo/), never the owner's key
VILLAIN_PAYMENT_WEI=500000000000000000  # fixed wei amount the villain attempts to pay per run (0.5 ETH) — a payment size, not a price
VILLAIN_TARGET_ADDRESS=  # a real 0x address nobody has called TrustReader.syncAgent() for, so it resolves FLAGGED — the villain's deliberately-unverified counterparty
SHOWCASE_SUBCONTRACTOR_KEY=  # scripts/register-agents.ts only. Local dev: one of anvil's printed dev-account keys (pnpm dev:chain's startup log), distinct from RILEY_SESSION_KEY and the two vars below
SHOWCASE_NEW_AGENT_KEY=      # scripts/register-agents.ts only. Another distinct anvil dev-account key, locally
SHOWCASE_FEEDBACK_CLIENT_KEY=  # scripts/register-agents.ts only. Must differ from SHOWCASE_SUBCONTRACTOR_KEY — the real ERC-8004 registry rejects self-feedback
LEDGER_ENABLED=true
SESSION_SECRET=  # 32+ char random string; signs the handler_session cookie
SESSION_TTL_SECONDS=604800
SIWE_NONCE_TTL_SECONDS=300
SIWE_DOMAIN=localhost:3000  # RFC 4501 domain the SIWE message must be signed for (host:port the web app runs on locally); the deployed hostname (no port) in prod
SIWE_CHAIN_ID=31337    # chain id the SIWE message must declare; matches CHAIN_ID above
WEB_ORIGIN=http://localhost:3000  # origin allowed to make cookied cross-origin requests to the api (CORS); the deployed web app's real origin in prod

# docker-compose.prod.yml only (Coolify deployment) — local dev uses DATABASE_URL above instead
POSTGRES_USER=postgres          # postgres, api (via composed DATABASE_URL)
POSTGRES_PASSWORD=changeme      # postgres, api (via composed DATABASE_URL)
POSTGRES_DB=handler             # postgres, api (via composed DATABASE_URL)
PORT=3000                       # api
NEXT_PUBLIC_API_URL=            # web (public URL the browser uses to reach api)
